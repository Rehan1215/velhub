local UserInputService = game:GetService("UserInputService")
local player = game.Players.LocalPlayer
local RepStorage = game:GetService("ReplicatedStorage")
local FishingSystem = RepStorage:WaitForChild("FishingSystem")

local VelHubGui = Instance.new("ScreenGui")
VelHubGui.Name = "VelHub_Integrated"
VelHubGui.Parent = game.CoreGui

--- [[ LOGIKA CORE FISHING (ENGINE V13) ]] ---
local isFishing = false
local currentRod = "Basic Rod"
local cachedZone = "stater"

-- Deteksi Rod & Zone Otomatis (Logika V13 kamu)
task.spawn(function()
    while true do
        pcall(function()
            local data = FishingSystem.InventoryEvents.Inventory_GetData:InvokeServer()
            if data then
                if data.EquippedRod then currentRod = data.EquippedRod end
                if data.CurrentZone then cachedZone = data.CurrentZone end
            end
        end)
        task.wait(3) 
    end
end)

