-- Logika Utama Memancing (Turbo V13)
local function universalLoop()
    while isFishing do
        pcall(function()
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            local targetPos = root.Position + (root.CFrame.LookVector * 20)
            local hookPos = targetPos - Vector3.new(0, 10, 0)

            FishingSystem.CastReplication:FireServer(targetPos, Vector3.new(0, 10, 0), currentRod, 100)
            task.wait(0.05) 
            FishingSystem.StartFishing:FireServer(hookPos)
            task.wait(0.01) 
            FishingSystem.RequestFishRoll:InvokeServer(hookPos)
            FishingSystem.FishGiver:FireServer({{hookPosition = hookPos, zone = cachedZone or "stater"}})
            FishingSystem.CleanupCast:FireServer()
        end)
        task.wait(0.01)
    end
end

ActivateBtn.MouseButton1Click:Connect(function()
    isFishing = not isFishing
    if isFishing then
        ActivateBtn.Text = "STOP FISHING"; ActivateBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "Status: FISHING..."; task.spawn(universalLoop)
    else
        ActivateBtn.Text = "ACTIVATE AUTO FISH"; ActivateBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        StatusLabel.Text = "Status: IDLE"
    end
end)

CloseBtn.MouseButton1Click:Connect(function() VelHubGui:Destroy() end)
