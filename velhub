--- [[ 6. LOGIKA SLIDER & NAVIGASI ]] ---
local dragging = false
SliderBtn.MouseButton1Down:Connect(function() dragging = true end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement) then
        local pos = math.clamp((input.Position.X - SliderBase.AbsolutePosition.X) / SliderBase.AbsoluteSize.X, 0, 1)
        SliderBtn.Position = UDim2.new(pos, -10, 0.5, -10)
        MainFrame.GroupTransparency = pos
    end
end)

local function switchTab(name)
    InfoPage.Visible = (name == "Info"); FishPage.Visible = (name == "Fishing"); SetPage.Visible = (name == "Settings")
    Title.Text = "Dashboard / " .. name
end

TabInfoBtn.MouseButton1Click:Connect(function() switchTab("Info") end)
TabFishBtn.MouseButton1Click:Connect(function() switchTab("Fishing") end)
